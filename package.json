{
  "name": "fig2tw",
  "version": "1.8.1",
  "description": "Figma plugin to generate a TailwindCSS plugin from Figma variables",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "dev": "vite",
    "build": "npm run build:ui && npm run build:main",
    "build:ui": "vite build",
    "build:main": "rollup -c rollup.config.js",
    "preview": "vite preview",
    "test": "vitest --coverage"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lodash": "^4.17.21",
    "mixpanel-figma": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.7",
    "@figma/plugin-typings": "^1.115.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/jsdom": "^30.0.0",
    "@types/lodash": "^4.17.10",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "rollup": "^4.21.3",
    "rollup-plugin-copy": "^3.5.0",
    "tailwindcss": "^3.4.12",
    "tslib": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.0",
